{
  "name": "@astryx-vue/charts",
  "type": "module",
  "version": "0.0.0",
  "description": "Astryx charts for Vue — a config-model data visualization layer (d3-based).",
  "author": "ShenQingchuan",
  "license": "MIT",
  "homepage": "https://astryx-vue.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astryx-vue/astryx-vue.git",
    "directory": "packages/charts"
  },
  "bugs": "https://github.com/astryx-vue/astryx-vue/issues",
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "astryx",
    "charts",
    "data-visualization"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./charts.css": {
        "types": "./css.d.ts",
        "default": "./charts.css"
      },
      "./styles/*.css": "./styles/*.css",
      "./package.json": "./package.json"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts.css": {
      "types": "./css.d.ts",
      "default": "./charts.css"
    },
    "./styles/*.css": "./styles/*.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "charts.css",
    "css.d.ts",
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@astryx-vue/core": "workspace:^",
    "vue": "catalog:peer"
  },
  "dependencies": {
    "d3-scale": "catalog:charts",
    "d3-shape": "catalog:charts"
  },
  "devDependencies": {
    "@astryx-vue/core": "workspace:^",
    "@types/d3-scale": "catalog:charts",
    "@types/d3-shape": "catalog:charts",
    "@types/node": "catalog:language",
    "@vue/compiler-sfc": "catalog:vue",
    "@vue/test-utils": "catalog:testing",
    "dom-accessibility-api": "catalog:testing",
    "tsdown": "catalog:build",
    "typescript": "catalog:language",
    "unplugin-vue": "catalog:build",
    "vue": "catalog:vue",
    "vue-tsc": "catalog:vue"
  }
}
