{
  "name": "@astryx-vue/themes",
  "type": "module",
  "version": "0.2.5",
  "description": "CSS themes for the unofficial astryx-vue port of Astryx. Not affiliated with Meta.",
  "author": "ShenQingchuan",
  "license": "MIT",
  "homepage": "https://astryx-vue.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astryx-vue/astryx-vue.git",
    "directory": "packages/themes"
  },
  "bugs": "https://github.com/astryx-vue/astryx-vue/issues",
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "astryx",
    "css",
    "themes",
    "ui"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./*.css": {
      "types": "./css.d.ts",
      "default": "./*.css"
    },
    "./*/*.css": {
      "types": "./css.d.ts",
      "default": "./*/*.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "butter",
    "butter.css",
    "chocolate",
    "chocolate.css",
    "css.d.ts",
    "fonts.css",
    "gothic",
    "gothic.css",
    "matcha",
    "matcha.css",
    "neutral",
    "neutral.css",
    "stone",
    "stone.css",
    "y2k",
    "y2k.css"
  ],
  "scripts": {
    "build": "true"
  },
  "dependencies": {
    "@fontsource/figtree": "catalog:runtime",
    "@fontsource/jetbrains-mono": "catalog:runtime"
  },
  "publishConfig": {
    "access": "public"
  }
}
