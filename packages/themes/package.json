{
  "name": "@astryx-vue/themes",
  "type": "module",
  "version": "0.0.0",
  "description": "Themes for the unofficial astryx-vue community project.",
  "author": "ShenQingchuan",
  "license": "MIT",
  "homepage": "https://astryx-vue.pages.dev",
  "bugs": "https://github.com/astryx-vue/astryx-vue/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astryx-vue/astryx-vue.git",
    "directory": "packages/themes"
  },
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "astryx",
    "components",
    "ui"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./*.css": {
      "types": "./css.d.ts",
      "default": "./*.css"
    },
    "./*/*.css": {
      "types": "./css.d.ts",
      "default": "./*/*.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "css.d.ts",
    "fonts.css",
    "neutral",
    "neutral.css"
  ],
  "scripts": {
    "build": "true"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "catalog:runtime"
  },
  "publishConfig": {
    "access": "public"
  }
}
