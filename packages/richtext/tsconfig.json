{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "customConditions": ["source"],
    "paths": {
      "@internationalized/date": [
        "../core/node_modules/@internationalized/date/dist/types/src/index.d.ts"
      ],
      "lexical": [
        "./node_modules/lexical/dist/index.d.ts"
      ],
      "@lexical/*": [
        "./node_modules/@lexical/*/dist/index.d.ts",
        "../../node_modules/.pnpm/node_modules/@lexical/*/dist/index.d.ts"
      ]
    },
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue"
  ]
}
