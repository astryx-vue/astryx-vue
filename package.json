{
  "name": "astryx-vue",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "description": "Unofficial Vue 3 port of Astryx — components, themes, and an agent-friendly CLI. Not affiliated with Meta.",
  "license": "MIT",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=11.21.0"
  },
  "scripts": {
    "build": "pnpm build:packages && pnpm docs:build",
    "build:packages": "pnpm --filter './packages/*' --recursive run build",
    "check": "pnpm check:packages && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm lint:pkg",
    "changeset": "changeset",
    "lint:pkg": "node ./scripts/lint-published.mjs",
    "release": "pnpm build:packages && changeset publish",
    "release:dry-run": "pnpm build:packages && pnpm --filter @astryx-vue/core --filter @astryx-vue/themes --filter @astryx-vue/cli publish --dry-run --no-git-checks",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "check:packages": "node ./scripts/check-package-boundaries.mjs && node ./scripts/check-path-case.mjs && node ./scripts/sync-exports.mjs --check && pnpm --filter @astryx-vue/cli generate:check && node ./scripts/check-line-limit.mjs && node ./scripts/check-no-important.mjs && pnpm check:i18n-catalog",
    "check:i18n-catalog": "node ./scripts/check-i18n-catalog.mjs",
    "check:templates": "node ./scripts/check-templates.mjs",
    "sync": "node ./scripts/sync-exports.mjs",
    "dev": "pnpm build:packages && pnpm --filter @astryx-vue/docs dev",
    "docs:build": "pnpm --filter @astryx-vue/docs build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter './packages/*' --filter './apps/*' --recursive --if-present run typecheck",
    "docs:preview": "pnpm --filter @astryx-vue/docs preview",
    "visual": "node scripts/swarm/visual-compare.mjs",
    "a11y": "node scripts/swarm/a11y-scan.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:linting",
    "@arethetypeswrong/cli": "catalog:release",
    "@astryx-vue/cli": "workspace:*",
    "@axe-core/playwright": "catalog:visual",
    "@changesets/changelog-github": "catalog:release",
    "@changesets/cli": "catalog:release",
    "@types/node": "catalog:language",
    "@types/pngjs": "catalog:visual",
    "@typescript/native": "catalog:language",
    "@vitejs/plugin-vue": "catalog:build",
    "@vue/compiler-dom": "catalog:vue",
    "@vue/compiler-sfc": "catalog:vue",
    "@vue/server-renderer": "catalog:vue",
    "@vue/test-utils": "catalog:testing",
    "dom-accessibility-api": "catalog:testing",
    "eslint": "catalog:linting",
    "eslint-plugin-vuejs-accessibility": "catalog:linting",
    "globals": "catalog:linting",
    "happy-dom": "catalog:testing",
    "pixelmatch": "catalog:visual",
    "playwright": "catalog:visual",
    "pngjs": "catalog:visual",
    "publint": "catalog:release",
    "typescript": "catalog:language",
    "vite": "catalog:build",
    "vitest": "catalog:testing",
    "vue": "catalog:vue",
    "wrangler": "catalog:deploy"
  },
  "upstream": {
    "repository": "https://github.com/facebook/astryx",
    "version": "0.4.1",
    "commit": "96f9917fe013a7062a403c58e54dfd47f482d89f"
  }
}
